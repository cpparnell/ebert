{
  "manifest_version": 3,
  "name": "Ebert",
  "version": "0.1.0",
  "description": "Letterboxd integration for the Criterion Channel",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://letterboxd.com/*",
    "https://cpparnell.github.io/*"
  ],
  "action": {
    "default_title": "Ebert",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.criterionchannel.com/*",
        "https://films.criterionchannel.com/*"
      ],
      "js": [
        "lib/shared.js",
        "lib/letterboxd.js",
        "lib/criterion.js",
        "lib/snapshot.js",
        "lib/user.js",
        "lib/taste.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}
